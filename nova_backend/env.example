# ── Azure AD App Registration ─────────────────────────────────────────────────
# Set AZURE_TENANT_ID=placeholder to run without Azure AD (dev bypass active).
# Set real values to enable JWT validation on all protected routes.
AZURE_TENANT_ID=placeholder
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_AUTHORITY=https://login.microsoftonline.com/placeholder

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# OPENAI_MODEL must match the deployment name in your Azure OpenAI resource,
# not the model name (they may differ, e.g. deployment "nova-gpt4o" → model gpt-4o-mini).
OPENAI_API_KEY=your-azure-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ── Classmate table-dump API (replaces Fabric SQL) ────────────────────────────
# Nightly sync pulls whole tables into a local SQLite warehouse (nova_warehouse.db).
API_ENDPOINT_URL=https://your-apim-host.azure-api.net/path/to/invoke
API_SUBSCRIPTION_KEY=your-apim-subscription-key-here
API_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
API_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
API_CLIENT_SECRET=your-api-client-secret-here
API_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/.default

# ── Nova App ──────────────────────────────────────────────────────────────────
NOVA_ENV=development
NOVA_SECRET_KEY=generate-a-secure-random-string-here
NOVA_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000"]
