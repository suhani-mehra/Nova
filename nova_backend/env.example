# ── Azure AD ──────────────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-nova-app-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id-here

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_RECOMMENDATION_CACHE_HOURS=24

# ── Database ──────────────────────────────────────────────────────────────────
# MVP: SQLite
DATABASE_URL=sqlite:///./nova.db
# Production Postgres (swap in when ready):
# DATABASE_URL=postgresql://user:password@host:5432/nova

# ── Classmate Data ────────────────────────────────────────────────────────────
CLASSMATE_DATA_PATH=./data/classmate

# ── Nova App ──────────────────────────────────────────────────────────────────
NOVA_ENV=development
NOVA_SECRET_KEY=replace-with-32-char-random-string
NOVA_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ── Tier Thresholds (top X% of employees) ────────────────────────────────────
TIER_PLATINUM_PCT=3
TIER_DIAMOND_PCT=10
TIER_GOLD_PCT=20
TIER_SILVER_PCT=40
TIER_BRONZE_PCT=60
# Below bronze = Starter (everyone else)

# ── Streak & Scoring ──────────────────────────────────────────────────────────
STREAK_MIN_SECONDS_PER_DAY=1800
AI_PROFICIENCY_MIN_SCORE=60
